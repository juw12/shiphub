# Copy this file to config.env (same folder as server.py) and fill in what you need.
# Real environment variables always win over this file.

# --- GitHub sign-in -------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://127.0.0.1:8000       (or your public URL)
#   Authorization callback URL: http://127.0.0.1:8000/auth/github/callback
# For a deployed site use https://YOUR-DOMAIN/auth/github/callback instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database --------------------------------------------------------------
# Leave empty to use SQLite in ./data/shiphub.db (zero setup).
# For Postgres: pip install "psycopg[binary]" and set e.g.
# DATABASE_URL=postgresql://user:password@host:5432/shiphub
DATABASE_URL=

# --- Site ---------------------------------------------------------------------
# Public address when deployed (used for GitHub redirects and secure cookies).
# PUBLIC_URL=https://shiphub.example.com

# Usernames that can delete any idea or comment (comma separated).
SHIPHUB_ADMINS=

# 1 = demo mode: sample accounts get known passwords and the
# "Continue with demo account" button shows. Use 0 on a public site.
SHIPHUB_DEMO=1

# Max upload size in MB for cover images and avatars.
# SHIPHUB_MAX_UPLOAD_MB=5

# Set to 1 when running behind a reverse proxy (Fly, Render, nginx) so rate
# limits see the real client IP.
# TRUST_PROXY=0
