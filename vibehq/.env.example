# Copy to .env (same folder as server.py) and fill in. Real environment variables override this file.

# Your domain (used by docker-compose/Caddy for automatic HTTPS)
DOMAIN=vibehq.example.com

# Public address people use to reach the server (needed for OAuth/Stripe redirects and push links).
# Must be HTTPS in production - Web Push and iPhone install require it.
PUBLIC_URL=https://vibehq.example.com

# ---- Stripe Connect (payments). Leave empty for demo mode (no real money).
# Dashboard -> Developers -> API keys. Use sk_test_... first.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> add endpoint  {PUBLIC_URL}/api/stripe/webhook
# events: checkout.session.completed, checkout.session.async_payment_succeeded, account.updated
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10
CURRENCY=usd

# ---- GitHub login + verified ships
# github.com/settings/developers -> New OAuth App
# callback URL: {PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# optional: a personal access token (no scopes) to raise the public API rate limit for verification
GITHUB_TOKEN=

# ---- Notifications
# Contact for push services (required by Apple/Mozilla). mailto: or https:
VAPID_SUBJECT=mailto:you@example.com
# ntfy server for phone alerts without HTTPS/PWA (self-host or use the public one)
NTFY_BASE=https://ntfy.sh

# ---- Security
# Sign users out after this many days of inactivity
SESSION_IDLE_DAYS=30
# Set to 1 ONLY when running behind your own reverse proxy (docker-compose does this for you)
TRUST_PROXY=0
